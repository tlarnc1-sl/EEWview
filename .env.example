# 接続先の切り替え。.env.local にコピーして使う。
# 既定は本番。実装を試すときだけ sandbox にする
# （約30秒に1回、2023年のデータを配信してくる。WebSocketは10分で切られる）。

# production | sandbox
VITE_P2P_ENV=production

# 個別に上書きしたいときだけ
# VITE_P2P_WS=wss://api.p2pquake.net/v2/ws
# VITE_P2P_HISTORY=https://api.p2pquake.net/v2/history
# VITE_WOLFX_WS=wss://ws-api.wolfx.jp/jma_eew
# VITE_WOLFX_JSON=https://api.wolfx.jp/jma_eew.json

# 起動時に /history を取りにいくか（CORSは実測で通っている）
VITE_FETCH_HISTORY=true
